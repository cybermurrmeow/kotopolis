# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite is enough for a local demo. Production uses PostgreSQL.
DATABASE_URL=sqlite:///kotopolis.db
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:5000
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true

# Email confirmation is disabled when these values are empty.
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

